<section class="min-h-[80vh] flex items-center justify-center px-6 py-20 bg-vintage-cream">
  <div class="w-full max-w-md">
    <div class="text-center mb-12">
      <span class="font-ultra text-[10px] tracking-[0.5em] text-forest-green uppercase mb-3 block">Welcome Back</span>
      <h1 class="font-ultra text-4xl md:text-5xl uppercase leading-none tracking-tighter text-muted-brown">Sign In</h1>
    </div>

    {%- form 'customer_login' -%}
      {%- if form.errors -%}
        <div class="border-2 border-red-300 bg-red-50 p-4 mb-6">
          <p class="font-ultra text-xs uppercase tracking-widest text-red-500">{{ form.errors | default_errors }}</p>
        </div>
      {%- endif -%}

      <div class="space-y-6">
        <div>
          <label for="CustomerEmail" class="font-ultra text-[10px] tracking-widest uppercase text-muted-brown/50 block mb-2">Email</label>
          <input type="email" name="customer[email]" id="CustomerEmail" autocomplete="email" autocorrect="off" autocapitalize="off"
            class="w-full bg-transparent border-b-2 border-muted-brown/20 py-4 font-ultra uppercase text-lg text-muted-brown focus:outline-none focus:border-muted-brown transition-colors placeholder:text-muted-brown/20"
            placeholder="your@email.com" />
        </div>
        <div>
          <label for="CustomerPassword" class="font-ultra text-[10px] tracking-widest uppercase text-muted-brown/50 block mb-2">Password</label>
          <input type="password" name="customer[password]" id="CustomerPassword" autocomplete="current-password"
            class="w-full bg-transparent border-b-2 border-muted-brown/20 py-4 font-ultra uppercase text-lg text-muted-brown focus:outline-none focus:border-muted-brown transition-colors placeholder:text-muted-brown/20"
            placeholder="••••••••" />
        </div>
        <button type="submit" class="w-full font-ultra text-sm text-vintage-cream bg-muted-brown py-5 uppercase tracking-[0.3em] hover:bg-forest-green transition-colors border-none cursor-pointer">
          Sign In
        </button>
      </div>

      <div class="mt-8 flex flex-col items-center gap-3 text-center">
        <a href="{{ routes.root_url }}account/recover" class="font-ultra text-[10px] tracking-widest uppercase text-muted-brown/50 hover:text-muted-brown transition-colors no-underline">Forgot password?</a>
        <span class="text-muted-brown/20">|</span>
        <a href="{{ routes.account_register_url }}" class="font-ultra text-[10px] tracking-widest uppercase text-forest-green hover:text-muted-brown transition-colors no-underline">Create an account</a>
      </div>
    {%- endform -%}
  </div>
</section>
