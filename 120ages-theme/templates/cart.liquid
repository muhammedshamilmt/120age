<section class="py-16 px-6 md:px-12 lg:px-24 bg-vintage-cream min-h-[60vh]">
  <div class="max-w-5xl mx-auto">

    <div class="mb-12">
      <span class="font-ultra text-[10px] tracking-[0.5em] text-forest-green uppercase mb-3 block">Your Order</span>
      <h1 class="font-ultra text-5xl md:text-7xl uppercase leading-none tracking-tighter text-muted-brown">Your Bag</h1>
    </div>

    {%- if cart.item_count > 0 -%}
      <form action="{{ routes.cart_url }}" method="post" id="cart-form">
        <div class="divide-y-2 divide-muted-brown/10 mb-12">
          {%- for item in cart.items -%}
            <div class="flex gap-6 py-8 items-start">
              <a href="{{ item.url }}" class="shrink-0 no-underline">
                <div class="w-24 h-24 md:w-32 md:h-32 border-2 border-muted-brown/10 overflow-hidden">
                  <img src="{{ item.image | image_url: width: 300 }}" alt="{{ item.title }}" class="w-full h-full object-cover" loading="lazy" />
                </div>
              </a>
              <div class="flex-1 min-w-0">
                <a href="{{ item.url }}" class="no-underline">
                  <span class="font-ultra text-[9px] tracking-widest text-forest-green uppercase block mb-1">{{ item.product.type }}</span>
                  <h3 class="font-ultra text-xl md:text-2xl uppercase text-muted-brown hover:text-forest-green transition-colors leading-tight mb-1">{{ item.product_title }}</h3>
                  {%- unless item.variant.title == 'Default Title' -%}
                    <p class="font-ultra text-[10px] tracking-widest text-muted-brown/50 uppercase">{{ item.variant.title }}</p>
                  {%- endunless -%}
                </a>
                <p class="font-ultra text-lg text-muted-brown mt-2">{{ item.final_price | money }}</p>
                <div class="flex items-center gap-4 mt-4">
                  <div class="flex items-center border-2 border-muted-brown/20">
                    <button type="button" class="px-3 py-2 text-muted-brown hover:bg-muted-brown/5 transition-colors qty-minus" data-id="{{ item.key }}">−</button>
                    <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" class="w-12 text-center font-ultra text-sm text-muted-brown bg-transparent border-none focus:outline-none" data-id="{{ item.key }}" />
                    <button type="button" class="px-3 py-2 text-muted-brown hover:bg-muted-brown/5 transition-colors qty-plus" data-id="{{ item.key }}">+</button>
                  </div>
                  <a href="{{ item.url_to_remove }}" class="font-ultra text-[9px] tracking-widest uppercase text-muted-brown/40 hover:text-red-500 transition-colors no-underline">Remove</a>
                </div>
              </div>
              <div class="text-right shrink-0">
                <p class="font-ultra text-xl text-muted-brown">{{ item.final_line_price | money }}</p>
              </div>
            </div>
          {%- endfor -%}
        </div>

        <div class="flex flex-col md:flex-row gap-8 justify-between items-start border-t-2 border-muted-brown/10 pt-10">
          <div class="w-full md:w-auto">
            <label class="font-ultra text-[10px] tracking-widest uppercase text-muted-brown/50 block mb-3">Order Notes</label>
            <textarea name="note" rows="3" class="w-full md:w-80 bg-transparent border-2 border-muted-brown/20 p-4 font-medium text-sm text-muted-brown focus:outline-none focus:border-muted-brown transition-colors resize-none placeholder:text-muted-brown/30" placeholder="Special instructions...">{{ cart.note }}</textarea>
          </div>
          <div class="w-full md:w-80 space-y-4">
            <div class="flex justify-between items-baseline border-b-2 border-muted-brown/10 pb-4">
              <span class="font-ultra text-[10px] tracking-widest uppercase text-muted-brown/50">Subtotal</span>
              <span class="font-ultra text-3xl text-muted-brown">{{ cart.total_price | money }}</span>
            </div>
            <p class="font-ultra text-[9px] tracking-widest uppercase text-muted-brown/40 text-center">Taxes and shipping calculated at checkout</p>
            <button type="submit" name="checkout" class="w-full font-ultra text-sm text-vintage-cream bg-muted-brown py-5 uppercase tracking-[0.3em] hover:bg-forest-green transition-colors border-none cursor-pointer">
              Checkout →
            </button>
            <a href="{{ routes.all_products_collection_url }}" class="block w-full text-center font-ultra text-[10px] tracking-widest uppercase text-muted-brown/50 hover:text-muted-brown transition-colors no-underline py-2">
              Continue Shopping
            </a>
          </div>
        </div>
      </form>

    {%- else -%}
      <div class="text-center py-32 space-y-6">
        <div class="w-24 h-24 border-2 border-muted-brown/20 flex items-center justify-center mx-auto">
          <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-muted-brown/30">
            <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/>
          </svg>
        </div>
        <p class="font-ultra text-3xl text-muted-brown/30 uppercase">Your bag is empty</p>
        <a href="{{ routes.all_products_collection_url }}" class="inline-block font-ultra text-sm text-vintage-cream bg-muted-brown px-12 py-5 uppercase tracking-[0.3em] hover:bg-forest-green transition-colors no-underline">
          Start Shopping
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

<script>
  document.querySelectorAll('.qty-minus').forEach(btn => {
    btn.addEventListener('click', () => {
      const input = btn.nextElementSibling;
      if (parseInt(input.value) > 0) input.value = parseInt(input.value) - 1;
    });
  });
  document.querySelectorAll('.qty-plus').forEach(btn => {
    btn.addEventListener('click', () => {
      const input = btn.previousElementSibling;
      input.value = parseInt(input.value) + 1;
    });
  });
</script>
