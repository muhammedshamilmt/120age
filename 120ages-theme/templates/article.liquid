<article class="bg-vintage-cream">

  <!-- Hero -->
  <section class="pt-20 pb-12 px-6 md:px-12 lg:px-24 border-b-2 border-muted-brown/10">
    <div class="max-w-4xl mx-auto">
      <a href="{{ blog.url }}" class="inline-flex items-center gap-2 font-ultra text-[10px] tracking-[0.3em] text-muted-brown/50 hover:text-muted-brown transition-colors uppercase no-underline mb-10">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
        {{ blog.title }}
      </a>
      <div class="flex flex-wrap gap-2 mb-6">
        {%- for tag in article.tags -%}
          <span class="font-ultra text-[9px] tracking-widest uppercase border border-forest-green text-forest-green px-2 py-1">{{ tag }}</span>
        {%- endfor -%}
      </div>
      <h1 class="font-ultra text-4xl md:text-6xl lg:text-7xl uppercase leading-[0.85] tracking-tighter text-muted-brown mb-8">{{ article.title }}</h1>
      <div class="flex items-center gap-4 text-muted-brown/50">
        <span class="font-ultra text-[10px] tracking-widest uppercase">{{ article.published_at | date: "%B %d, %Y" }}</span>
        <span class="w-1 h-1 rounded-full bg-muted-brown/30"></span>
        <span class="font-ultra text-[10px] tracking-widest uppercase">By {{ article.author }}</span>
        <span class="w-1 h-1 rounded-full bg-muted-brown/30"></span>
        <span class="font-ultra text-[10px] tracking-widest uppercase">{{ article.content | strip_html | split: ' ' | size | divided_by: 200 | plus: 1 }} min read</span>
      </div>
    </div>
  </section>

  <!-- Featured Image -->
  {%- if article.image -%}
    <div class="px-6 md:px-12 lg:px-24 py-10 bg-vintage-cream">
      <div class="max-w-4xl mx-auto relative aspect-[16/9] border-2 border-muted-brown/10 overflow-hidden">
        {{ article.image | image_url: width: 1200 | image_tag: class: 'absolute inset-0 w-full h-full object-cover', loading: 'eager' }}
      </div>
    </div>
  {%- endif -%}

  <!-- Content -->
  <section class="py-12 px-6 md:px-12 lg:px-24 bg-vintage-cream">
    <div class="max-w-3xl mx-auto">
      <div class="article-content text-muted-brown/80 text-lg leading-relaxed font-medium space-y-6">
        {{ article.content }}
      </div>

      <!-- Tags -->
      {%- if article.tags.size > 0 -%}
        <div class="mt-16 pt-8 border-t-2 border-muted-brown/10 flex flex-wrap gap-2 items-center">
          <span class="font-ultra text-[10px] tracking-widest uppercase text-muted-brown/40 mr-2">Tags:</span>
          {%- for tag in article.tags -%}
            <a href="{{ blog.url }}/tagged/{{ tag | handle }}" class="font-ultra text-[9px] tracking-widest uppercase border border-muted-brown/20 text-muted-brown/60 px-3 py-1 hover:border-muted-brown hover:text-muted-brown transition-colors no-underline">{{ tag }}</a>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <!-- Prev / Next -->
      <div class="mt-16 pt-8 border-t-2 border-muted-brown/10 grid grid-cols-2 gap-8">
        {%- if blog.previous_article -%}
          <a href="{{ blog.previous_article }}" class="group no-underline">
            <span class="font-ultra text-[9px] tracking-widest uppercase text-muted-brown/40 block mb-2">← Previous</span>
            <span class="font-ultra text-sm uppercase text-muted-brown group-hover:text-forest-green transition-colors">{{ blog.previous_article.title }}</span>
          </a>
        {%- else -%}<div></div>{%- endif -%}
        {%- if blog.next_article -%}
          <a href="{{ blog.next_article }}" class="group no-underline text-right">
            <span class="font-ultra text-[9px] tracking-widest uppercase text-muted-brown/40 block mb-2">Next →</span>
            <span class="font-ultra text-sm uppercase text-muted-brown group-hover:text-forest-green transition-colors">{{ blog.next_article.title }}</span>
          </a>
        {%- endif -%}
      </div>
    </div>
  </section>
</article>

<style>
  .article-content h2 { font-family: var(--font-ultra), serif; font-size: 1.75rem; text-transform: uppercase; letter-spacing: -0.02em; color: #9E7556; margin-top: 3rem; margin-bottom: 1rem; }
  .article-content h3 { font-family: var(--font-ultra), serif; font-size: 1.25rem; text-transform: uppercase; color: #9E7556; margin-top: 2rem; margin-bottom: 0.75rem; }
  .article-content a { color: #50A845; border-bottom: 1px solid #50A845; }
  .article-content ul, .article-content ol { padding-left: 1.5rem; }
  .article-content blockquote { border-left: 4px solid #9E7556; padding-left: 1.5rem; font-style: italic; opacity: 0.8; }
  .article-content img { width: 100%; border: 2px solid rgba(158,117,86,0.1); }
</style>
