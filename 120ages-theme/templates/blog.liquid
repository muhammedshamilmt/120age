<section class="pt-24 pb-16 px-6 border-b-2 border-muted-brown/10 bg-vintage-cream">
  <div class="max-w-7xl mx-auto text-center">
    <span class="font-ultra text-xs tracking-[0.5em] text-forest-green uppercase mb-4 block">Stories & Guides</span>
    <h1 class="font-ultra text-5xl md:text-7xl lg:text-8xl text-muted-brown uppercase leading-none tracking-tighter mb-6">{{ blog.title }}</h1>
    <p class="max-w-xl mx-auto text-muted-brown/60 font-medium">Wellness wisdom, herbal guides, and stories from our community.</p>
  </div>
</section>

<section class="py-20 px-6 md:px-12 lg:px-24 bg-vintage-cream">
  <div class="max-w-7xl mx-auto">
    {%- paginate blog.articles by 9 -%}
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
        {%- for article in blog.articles -%}
          <article class="group">
            <a href="{{ article.url }}" class="block no-underline">
              <div class="relative aspect-[4/3] overflow-hidden border-2 border-muted-brown/10 group-hover:border-muted-brown/40 transition-colors mb-5">
                {%- if article.image -%}
                  {{ article.image | image_url: width: 800 | image_tag: class: 'absolute inset-0 w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-700 group-hover:scale-105', loading: 'lazy' }}
                {%- else -%}
                  <div class="absolute inset-0 bg-muted-brown/5 flex items-center justify-center">
                    <span class="font-ultra text-muted-brown/20 text-4xl uppercase">{{ article.title | slice: 0 }}</span>
                  </div>
                {%- endif -%}
                <div class="absolute top-4 left-4">
                  <span class="bg-forest-green text-vintage-cream px-3 py-1 font-ultra text-[9px] tracking-widest uppercase">{{ article.tags | first | default: 'Wellness' }}</span>
                </div>
              </div>
              <div class="flex items-center gap-3 mb-3">
                <span class="font-ultra text-[9px] tracking-widest uppercase text-muted-brown/40">{{ article.published_at | date: "%b %d, %Y" }}</span>
                <span class="w-1 h-1 rounded-full bg-muted-brown/20"></span>
                <span class="font-ultra text-[9px] tracking-widest uppercase text-muted-brown/40">{{ article.content | strip_html | split: ' ' | size | divided_by: 200 | plus: 1 }} min read</span>
              </div>
              <h2 class="font-ultra text-xl md:text-2xl uppercase text-muted-brown group-hover:text-forest-green transition-colors leading-tight mb-3">{{ article.title }}</h2>
              <p class="text-muted-brown/60 text-sm leading-relaxed line-clamp-2">{{ article.excerpt_or_content | strip_html | truncatewords: 25 }}</p>
              <div class="mt-4 h-px w-8 bg-muted-brown group-hover:w-full transition-all duration-500"></div>
            </a>
          </article>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <div class="mt-20 flex justify-center items-center gap-4 border-t-2 border-muted-brown/10 pt-12">
          {%- if paginate.previous -%}
            <a href="{{ paginate.previous.url }}" class="font-ultra text-xs tracking-widest uppercase text-muted-brown border-2 border-muted-brown px-8 py-3 hover:bg-muted-brown hover:text-vintage-cream transition-colors no-underline">← Prev</a>
          {%- endif -%}
          <span class="font-ultra text-xs tracking-widest text-muted-brown/50 uppercase">Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
          {%- if paginate.next -%}
            <a href="{{ paginate.next.url }}" class="font-ultra text-xs tracking-widest uppercase text-muted-brown border-2 border-muted-brown px-8 py-3 hover:bg-muted-brown hover:text-vintage-cream transition-colors no-underline">Next →</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>
