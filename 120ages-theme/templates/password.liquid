<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ shop.name }} — Coming Soon</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Ultra&display=swap" rel="stylesheet">
  <script src="https://unpkg.com/@tailwindcss/browser@4"></script>
  <style type="text/tailwindcss">
    @theme {
      --font-ultra: "Ultra", serif;
      --color-muted-brown: #9E7556;
      --color-forest-green: #50A845;
      --color-vintage-cream: #FFEAD3;
    }
  </style>
  {{ content_for_header }}
</head>
<body class="bg-[#FFEAD3] min-h-screen flex flex-col items-center justify-center px-6">

  <div class="text-center max-w-2xl mx-auto space-y-8">
    <span class="font-ultra text-[10px] tracking-[0.5em] text-[#50A845] uppercase block">EST. 2026</span>
    <h1 class="font-ultra text-[15vw] md:text-[10vw] text-[#9E7556] uppercase leading-none tracking-tighter">
      {{ shop.name }}
    </h1>
    <p class="font-ultra text-lg md:text-xl uppercase text-[#9E7556]/60 tracking-widest">
      Something nourishing is coming.
    </p>

    {%- form 'storefront_password' -%}
      {%- if form.errors -%}
        <p class="font-ultra text-xs uppercase tracking-widest text-red-500">Wrong password. Try again.</p>
      {%- endif -%}
      <div class="flex border-2 border-[#9E7556] max-w-md mx-auto">
        <input
          type="password"
          name="password"
          placeholder="Enter password"
          class="flex-1 bg-transparent px-6 py-4 font-ultra uppercase text-sm text-[#9E7556] placeholder:text-[#9E7556]/30 focus:outline-none"
        />
        <button type="submit" class="px-8 py-4 bg-[#9E7556] text-[#FFEAD3] font-ultra text-xs tracking-widest uppercase hover:bg-[#50A845] transition-colors border-none cursor-pointer">
          Enter
        </button>
      </div>
    {%- endform -%}

    <p class="font-ultra text-[9px] tracking-[0.4em] uppercase text-[#9E7556]/30">
      Are you the store owner? <a href="/admin" class="text-[#9E7556]/60 hover:text-[#9E7556] transition-colors">Log in here</a>
    </p>
  </div>

</body>
</html>
