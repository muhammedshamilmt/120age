<section class="pt-24 pb-16 px-6 border-b-2 border-muted-brown/10 bg-vintage-cream">
  <div class="max-w-3xl mx-auto text-center">
    <span class="font-ultra text-xs tracking-[0.5em] text-forest-green uppercase mb-4 block">Discover</span>
    <h1 class="font-ultra text-5xl md:text-7xl uppercase leading-none tracking-tighter text-muted-brown mb-10">Search</h1>
    <form action="{{ routes.search_url }}" method="get" role="search" class="flex border-2 border-muted-brown">
      <input type="hidden" name="type" value="product,article,page" />
      <input
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="Search products, articles..."
        class="flex-1 bg-transparent px-6 py-4 font-ultra uppercase text-sm text-muted-brown placeholder:text-muted-brown/30 focus:outline-none"
      />
      <button type="submit" class="px-8 py-4 bg-muted-brown text-vintage-cream font-ultra text-xs tracking-widest uppercase hover:bg-forest-green transition-colors border-none cursor-pointer">
        Search
      </button>
    </form>
  </div>
</section>

<section class="py-20 px-6 md:px-12 lg:px-24 bg-vintage-cream">
  <div class="max-w-7xl mx-auto">
    {%- if search.performed -%}
      {%- if search.results_count == 0 -%}
        <div class="text-center py-20">
          <p class="font-ultra text-3xl text-muted-brown/30 uppercase mb-4">No results for "{{ search.terms }}"</p>
          <p class="text-muted-brown/50 font-medium">Try a different search term or browse our collections.</p>
          <a href="{{ routes.all_products_collection_url }}" class="inline-block mt-8 font-ultra text-sm text-vintage-cream bg-muted-brown px-10 py-4 uppercase tracking-[0.2em] hover:bg-forest-green transition-colors no-underline">Browse All</a>
        </div>
      {%- else -%}
        <div class="mb-10 flex items-end justify-between border-b-2 border-muted-brown/10 pb-6">
          <h2 class="font-ultra text-2xl uppercase text-muted-brown">Results for "{{ search.terms }}"</h2>
          <span class="font-ultra text-[10px] tracking-widest uppercase text-muted-brown/40">{{ search.results_count }} found</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', product: item %}
            {%- else -%}
              <a href="{{ item.url }}" class="group block no-underline border-2 border-muted-brown/10 hover:border-muted-brown transition-colors p-6">
                <span class="font-ultra text-[9px] tracking-widest uppercase text-forest-green block mb-2">{{ item.object_type }}</span>
                <h3 class="font-ultra text-lg uppercase text-muted-brown group-hover:text-forest-green transition-colors mb-3">{{ item.title }}</h3>
                <p class="text-muted-brown/60 text-sm line-clamp-2">{{ item.content | strip_html | truncatewords: 20 }}</p>
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- else -%}
      <div class="text-center py-20">
        <p class="font-ultra text-muted-brown/30 uppercase tracking-widest">Enter a search term above</p>
      </div>
    {%- endif -%}
  </div>
</section>
