<!-- Contact Hero -->
<section class="relative min-h-[40vh] flex flex-col items-center justify-center overflow-hidden bg-[#1A1A1A] pt-20">
  <!-- Decorative Background -->
    <div class="absolute inset-0 pointer-events-none opacity-[0.05] flex items-center justify-center z-0">
      <img 
        src="https://slelguoygbfzlpylpxfs.supabase.co/storage/v1/render/image/public/project-uploads/df78dac5-7d8d-47bd-994b-90e733dd5e67/image-1769497755900.png?width=1200&height=1200&resize=contain"
        alt="Background Texture"
        class="w-full h-full object-contain scale-150 rotate-45 invert"
      />
    </div>

  <div class="relative z-10 text-center px-6">
    <span class="font-ultra text-forest-green text-sm md:text-base tracking-[0.3em] uppercase mb-4 block animate-fade-in">
      Get in Touch
    </span>
    <h1 class="text-[10vw] md:text-[6vw] font-ultra text-vintage-cream leading-[0.85] uppercase tracking-tighter mb-8">
      {{ page.title | default: 'Contact Us' }}
    </h1>
  </div>

  <!-- Bottom Decorative Line -->
  <div class="absolute bottom-0 left-0 w-full h-px bg-vintage-cream/20 flex justify-center">
    <div class="bg-[#1A1A1A] px-4 -translate-y-1/2 font-ultra text-vintage-cream text-xs tracking-widest uppercase">
      We're Here
    </div>
  </div>
</section>

<!-- Contact Form Section -->
<section class="py-24 bg-vintage-cream text-foreground">
  <div class="max-w-4xl mx-auto px-6">
    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-6xl font-ultra text-[#1A1A1A] uppercase leading-none tracking-tighter mb-6">
        Drop Us a <span class="text-forest-green">Line</span>
      </h2>
      <p class="text-xl text-muted-brown font-medium leading-relaxed max-w-2xl mx-auto">
        Have a question about our blends, your order, or just want to say hello? We'd love to hear from you.
      </p>
    </div>

    {% form 'contact', class: 'border-2 border-muted-brown/20 p-8 md:p-12 bg-white relative group' %}
      {% if form.posted_successfully? %}
        <div class="bg-forest-green/10 border-2 border-forest-green text-forest-green p-6 mb-8 font-ultra text-sm uppercase tracking-widest text-center">
          Thanks for reaching out. We'll get back to you soon.
        </div>
      {% endif %}

      {{ form.errors | default_errors }}

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
        <div class="relative">
          <label for="ContactFormName" class="block font-ultra text-xs tracking-[0.2em] text-muted-brown uppercase mb-2">Name</label>
          <input type="text" id="ContactFormName" name="contact[name]" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}" class="w-full bg-transparent border-b-2 border-muted-brown/20 py-4 font-ultra uppercase text-lg focus:outline-none focus:border-forest-green transition-colors text-[#1A1A1A] placeholder:text-muted-brown/30" placeholder="Jane Doe">
        </div>
        
        <div class="relative">
          <label for="ContactFormEmail" class="block font-ultra text-xs tracking-[0.2em] text-muted-brown uppercase mb-2">Email</label>
          <input type="email" id="ContactFormEmail" name="contact[email]" autocorrect="off" autocapitalize="off" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}" class="w-full bg-transparent border-b-2 border-muted-brown/20 py-4 font-ultra uppercase text-lg focus:outline-none focus:border-forest-green transition-colors text-[#1A1A1A] placeholder:text-muted-brown/30" placeholder="jane@example.com">
        </div>
      </div>

      <div class="relative mb-8">
        <label for="ContactFormPhone" class="block font-ultra text-xs tracking-[0.2em] text-muted-brown uppercase mb-2">Phone Number</label>
        <input type="tel" id="ContactFormPhone" name="contact[phone]" pattern="[0-9\-]*" value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}" class="w-full bg-transparent border-b-2 border-muted-brown/20 py-4 font-ultra uppercase text-lg focus:outline-none focus:border-forest-green transition-colors text-[#1A1A1A] placeholder:text-muted-brown/30" placeholder="(555) 555-5555">
      </div>

      <div class="relative mb-12">
        <label for="ContactFormMessage" class="block font-ultra text-xs tracking-[0.2em] text-muted-brown uppercase mb-2">Message</label>
        <textarea rows="5" id="ContactFormMessage" name="contact[body]" class="w-full bg-transparent border-b-2 border-muted-brown/20 py-4 font-ultra uppercase text-lg focus:outline-none focus:border-forest-green transition-colors text-[#1A1A1A] placeholder:text-muted-brown/30 resize-none line-clamp-4 leading-relaxed" placeholder="Tell us what's on your mind...">{% if form.body %}{{ form.body }}{% endif %}</textarea>
      </div>

      <div class="text-center">
        <button type="submit" class="bg-forest-green text-vintage-cream px-16 py-6 font-ultra uppercase text-sm tracking-[0.2em] hover:bg-[#1A1A1A] transition-colors cursor-pointer w-full md:w-auto">
          Send Message
        </button>
      </div>

      <!-- Decorative Corners -->
      <div class="absolute top-0 left-0 w-8 h-8 border-t-2 border-l-2 border-muted-brown/20 transition-all group-hover:w-full group-hover:h-full group-hover:opacity-10 pointer-events-none"></div>
      <div class="absolute bottom-0 right-0 w-8 h-8 border-b-2 border-r-2 border-muted-brown/20 transition-all group-hover:w-full group-hover:h-full group-hover:opacity-10 pointer-events-none"></div>
    {% endform %}
  </div>
</section>

<!-- Page Content (if any added from admin) -->
{% if page.content != blank %}
  <section class="py-16 bg-vintage-cream border-t border-muted-brown/10 text-[#1A1A1A]">
    <div class="max-w-4xl mx-auto px-6 prose prose-lg prose-headings:font-ultra prose-headings:uppercase prose-p:font-medium prose-a:text-forest-green">
      {{ page.content }}
    </div>
  </section>
{% endif %}
