<section class="py-12 px-6 md:px-12 lg:px-24 bg-vintage-cream" data-section-id="{{ section.id }}" data-section-type="product">
  <div class="max-w-7xl mx-auto">
    <!-- Breadcrumb -->
    <div class="mb-12">
        <a href="{{ collection.url | default: '/collections/all' }}" class="inline-flex items-center gap-2 font-ultra text-[10px] tracking-[0.3em] text-muted-brown/60 hover:text-muted-brown transition-colors uppercase no-underline">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
          Back to {% if collection %}{{ collection.title }}{% else %}Shop{% endif %}
        </a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
      <!-- Media Gallery -->
      <div class="space-y-4 md:sticky md:top-8">
        <div class="relative aspect-square bg-white border-2 border-muted-brown/10 overflow-hidden group">
          {%- assign featured_media = product.selected_or_first_available_variant.featured_media | default: product.featured_media -%}
          {%- if featured_media != blank -%}
             {{ featured_media | image_url: width: 1200 | image_tag: class: 'absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 main-product-image', id: 'MainProductImage' }}
          {%- else -%}
             {{ 'product-1' | placeholder_svg_tag: 'absolute inset-0 w-full h-full grayscale' }}
          {%- endif -%}
          
          {%- if product.available == false -%}
             <div class="absolute top-4 left-4 bg-black text-vintage-cream font-ultra text-[9px] tracking-widest uppercase px-3 py-1.5">Sold Out</div>
          {%- endif -%}
          <div class="absolute top-4 right-4 bg-muted-brown text-vintage-cream font-ultra text-[9px] tracking-widest uppercase px-3 py-1.5 group-hover:bg-forest-green transition-colors">Premium Quality</div>
        </div>

        {%- if product.media.size > 1 -%}
          <div class="grid grid-cols-4 gap-3">
            {%- for media in product.media -%}
              <div class="aspect-square border-2 {% if media == featured_media %}border-muted-brown{% else %}border-muted-brown/20{% endif %} overflow-hidden cursor-pointer hover:border-muted-brown transition-colors thumbnail-item" data-media-url="{{ media | image_url: width: 1200 }}">
                {{ media | image_url: width: 200 | image_tag: class: 'w-full h-full object-cover' }}
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <!-- Product Info -->
      <div class="flex flex-col text-left">
        <div class="space-y-3 mb-8">
          <div class="flex flex-wrap gap-2">
            <span class="font-ultra text-[9px] tracking-[0.4em] text-forest-green uppercase border border-forest-green px-2 py-1">{{ product.type }}</span>
            {%- for tag in product.tags limit: 2 -%}
               <span class="font-ultra text-[9px] tracking-[0.4em] text-muted-brown/60 uppercase border border-muted-brown/20 px-2 py-1">{{ tag }}</span>
            {%- endfor -%}
          </div>
          <h1 class="font-ultra text-4xl md:text-5xl lg:text-6xl text-muted-brown uppercase leading-[0.9] tracking-tight">
            {{ product.title | replace: ' ', '<br />' }}
          </h1>
          <p class="font-ultra text-xs tracking-widest text-muted-brown/50 uppercase">{{ product.vendor }}</p>
        </div>

        <div class="flex items-center gap-3 mb-8">
          <div class="flex gap-0.5">
            {%- for i in (1..5) -%}
               <svg class="w-4 h-4 fill-muted-brown" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
            {%- endfor -%}
          </div>
          <span class="font-ultra text-xs text-muted-brown/60 tracking-widest uppercase">Verified Pure</span>
          <span class="w-1 h-1 bg-muted-brown/30 rounded-full"></span>
          <span class="font-ultra text-xs {% if product.available %}text-forest-green{% else %}text-muted-brown/40{% endif %} tracking-widest uppercase">
            {% if product.available %}In Stock{% else %}Out of Stock{% endif %}
          </span>
        </div>

        <div class="border-t border-b border-muted-brown/10 py-6 mb-8">
          <p class="font-ultra text-4xl text-muted-brown" id="ProductPrice">{{ product.selected_or_first_available_variant.price | money }}</p>
          {%- if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price -%}
             <p class="font-ultra text-xl text-muted-brown/40 line-through mt-1">{{ product.selected_or_first_available_variant.compare_at_price | money }}</p>
          {%- endif -%}
        </div>

        {%- form 'product', product, id: 'product-form', class: 'space-y-8' -%}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

          {%- unless product.has_only_default_variant -%}
            <div class="space-y-4">
              {%- for option in product.options_with_values -%}
                <div class="space-y-2">
                  <div class="flex items-center justify-between">
                    <h3 class="font-ultra text-xs tracking-[0.3em] text-muted-brown uppercase">{{ option.name }}</h3>
                  </div>
                  <div class="flex flex-wrap gap-3">
                    {%- for value in option.values -%}
                      <button type="button" 
                        class="variant-btn font-ultra text-xs tracking-widest uppercase px-5 py-3 border-2 transition-all duration-200 cursor-pointer rounded-none
                        {% if option.selected_value == value %}bg-muted-brown text-vintage-cream border-muted-brown{% else %}bg-transparent text-muted-brown border-muted-brown/30 hover:border-muted-brown{% endif %}"
                        data-option-index="{{ forloop.parentloop.index0 }}"
                        data-value="{{ value | escape }}">
                        {{ value }}
                      </button>
                    {%- endfor -%}
                  </div>
                </div>
              {%- endfor -%}
            </div>
          {%- endunless -%}

          <div class="space-y-3 pt-2">
            <button type="submit" name="add" 
              {% unless product.available %}disabled{% endunless %}
              class="w-full font-ultra text-sm text-vintage-cream bg-muted-brown py-5 uppercase tracking-[0.3em] hover:bg-forest-green transition-all duration-300 shadow-[6px_6px_0px_0px_rgba(80,168,69,0.4)] enabled:hover:shadow-none enabled:hover:translate-x-1 enabled:hover:translate-y-1 cursor-pointer border-none rounded-none disabled:opacity-50 disabled:cursor-not-allowed">
              {% if product.available %}Add to Cart{% else %}Sold Out{% endif %}
            </button>
            {{ form | payment_button }}
          </div>
        {%- endform -%}

        <div class="space-y-3 pt-8 border-t border-muted-brown/10 mt-8">
          <div class="flex gap-3 items-start">
            <span class="font-ultra text-[10px] tracking-widest text-muted-brown/40 uppercase w-24 flex-shrink-0 pt-0.5">Origin</span>
            <span class="font-ultra text-[10px] tracking-widest text-muted-brown uppercase">{{ product.metafields.custom.origin | default: 'Maldon, UK' }}</span>
          </div>
          <div class="flex gap-3 items-start">
            <span class="font-ultra text-[10px] tracking-widest text-muted-brown/40 uppercase w-24 flex-shrink-0 pt-0.5">SKU</span>
            <span class="font-ultra text-[10px] tracking-widest text-muted-brown uppercase">{{ product.selected_or_first_available_variant.sku }}</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Simple Thumbnail Switcher
  document.querySelectorAll('.thumbnail-item').forEach(item => {
    item.addEventListener('click', () => {
      const url = item.dataset.mediaUrl;
      document.getElementById('MainProductImage').src = url;
      document.querySelectorAll('.thumbnail-item').forEach(i => i.classList.remove('border-muted-brown'));
      document.querySelectorAll('.thumbnail-item').forEach(i => i.classList.add('border-muted-brown/20'));
      item.classList.remove('border-muted-brown/20');
      item.classList.add('border-muted-brown');
    });
  });

  // Variant Selection Logic (Simplified)
  const product = {{ product | json }};
  document.querySelectorAll('.variant-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const optionIndex = parseInt(btn.dataset.optionIndex);
      const value = btn.dataset.value;
      
      // Update UI for buttons
      btn.closest('.flex').querySelectorAll('.variant-btn').forEach(b => {
        b.classList.remove('bg-muted-brown', 'text-vintage-cream', 'border-muted-brown');
        b.classList.add('bg-transparent', 'text-muted-brown', 'border-muted-brown/30');
      });
      btn.classList.add('bg-muted-brown', 'text-vintage-cream', 'border-muted-brown');
      btn.classList.remove('bg-transparent', 'border-muted-brown/30');

      // Find Variant (basic implementation)
      const selectedOptions = Array.from(document.querySelectorAll('.variant-btn.bg-muted-brown')).map(b => b.dataset.value);
      const variant = product.variants.find(v => {
        return v.options.every((opt, i) => opt === selectedOptions[i]);
      });

      if (variant) {
        document.querySelector('input[name="id"]').value = variant.id;
        document.getElementById('ProductPrice').textContent = Shopify.formatMoney(variant.price, "{{ shop.money_format }}");
        
        const addToCartBtn = document.querySelector('button[name="add"]');
        if (variant.available) {
          addToCartBtn.disabled = false;
          addToCartBtn.textContent = 'Add to Cart';
        } else {
          addToCartBtn.disabled = true;
          addToCartBtn.textContent = 'Sold Out';
        }
      }
    });
  });
</script>

{% schema %}
{
  "name": "Main Product High",
  "settings": []
}
{% endschema %}
