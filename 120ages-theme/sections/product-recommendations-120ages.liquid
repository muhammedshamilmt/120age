<section class="py-20 px-6 md:px-12 lg:px-24 bg-white border-t-2 border-muted-brown/10" data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit=4">
  <div class="max-w-7xl mx-auto">
    {%- if recommendations.performed and recommendations.products_count > 0 -%}
      <div class="flex items-end justify-between mb-12">
        <h2 class="font-ultra text-4xl md:text-5xl uppercase leading-none tracking-tight text-muted-brown">You May<br /><span class="text-forest-green">Also Like</span></h2>
        <a href="{{ routes.all_products_collection_url }}" class="font-ultra text-[10px] tracking-widest uppercase text-muted-brown/60 hover:text-muted-brown transition-colors border-b border-muted-brown/30 pb-1 no-underline">View All</a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
        {%- for product in recommendations.products -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="product-recommendations-placeholder">
         <!-- This will be replaced by the fetched content -->
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Related Products High",
  "settings": []
}
{% endschema %}

<script>
  const handleIntersection = (entries, observer) => {
    if (!entries[0].isIntersecting) return;
    observer.unobserve(productRecommendationsSection);

    const url = productRecommendationsSection.dataset.url;

    fetch(url)
      .then(response => response.text())
      .then(text => {
        const html = new DOMParser().parseFromString(text, 'text/html');
        const recommendations = html.querySelector('.max-w-7xl');

        if (recommendations && recommendations.innerHTML.trim().length > 0) {
          productRecommendationsSection.innerHTML = recommendations.innerHTML;
        }
      })
      .catch(e => {
        console.error(e);
      });
  };

  const productRecommendationsSection = document.querySelector('[data-url]');
  const observer = new IntersectionObserver(handleIntersection, {rootMargin: '0px 0px 200px 0px'});

  if (productRecommendationsSection) {
    observer.observe(productRecommendationsSection);
  }
</script>
