<section class="bg-[#1A1A1A] px-6 py-20 md:px-12 md:py-32 lg:px-24">
  <div class="max-w-screen-2xl mx-auto">
    <div class="mb-16 flex flex-col md:flex-row md:items-end justify-between gap-6 overflow-hidden">
      <div class="text-left">
        <span class="font-ultra text-[10px] tracking-[0.4em] uppercase text-forest-green block mb-4">
          {{ section.settings.subheading }}
        </span>
        <h2 class="text-4xl md:text-7xl lg:text-[100px] font-ultra uppercase leading-[0.85] tracking-tighter text-vintage-cream">
          {{ section.settings.title }}
        </h2>
      </div>
      <div class="flex items-center gap-3 self-start md:self-end">
        <span class="font-ultra text-5xl text-vintage-cream">{{ section.settings.rating }}</span>
        <div class="text-left">
          <div class="flex gap-1 mb-1">
            <span class="text-forest-green text-lg">★</span>
            <span class="text-forest-green text-lg">★</span>
            <span class="text-forest-green text-lg">★</span>
            <span class="text-forest-green text-lg">★</span>
            <span class="text-forest-green text-lg">★</span>
          </div>
          <span class="font-ultra text-[9px] tracking-widest uppercase text-vintage-cream/40">
            {{ section.settings.count_label }}
          </span>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {%- for block in section.blocks -%}
        <div class="border border-vintage-cream/10 p-6 md:p-8 hover:border-forest-green/40 transition-colors text-left" {{ block.shopify_attributes }}>
          <div class="flex gap-0.5 mb-4">
            <span class="text-forest-green text-sm">★</span>
            <span class="text-forest-green text-sm">★</span>
            <span class="text-forest-green text-sm">★</span>
            <span class="text-forest-green text-sm">★</span>
            <span class="text-forest-green text-sm">★</span>
          </div>
          <p class="font-ultra text-lg md:text-xl uppercase text-vintage-cream leading-snug mb-6">
            "{{ block.settings.text }}"
          </p>
          <div class="flex items-center justify-between border-t border-vintage-cream/10 pt-4">
            <div class="text-left">
              <span class="font-ultra text-sm uppercase text-vintage-cream block text-left">{{ block.settings.author }}</span>
              <span class="font-ultra text-[9px] tracking-widest uppercase text-forest-green text-left">{{ block.settings.product }}</span>
            </div>
            <span class="font-ultra text-[9px] tracking-widest uppercase text-vintage-cream/30">March 2026</span>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Reviews High",
  "settings": [
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "What They Say" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Reviews" },
    { "type": "text", "id": "rating", "label": "Average Rating", "default": "5.0" },
    { "type": "text", "id": "count_label", "label": "Count Label", "default": "4 Reviews" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "textarea", "id": "text", "label": "Review Text", "default": "The Classic Herbal Blend has become my morning ritual. Absolutely divine — earthy, calming, and full of character." },
        { "type": "text", "id": "author", "label": "Author", "default": "Sarah K." },
        { "type": "text", "id": "product", "label": "Product", "default": "Classic Herbal Blend" }
      ]
    }
  ],
  "presets": [
    { 
      "name": "Reviews High",
      "blocks": [
        { "type": "review", "settings": { "author": "Sarah K." } },
        { "type": "review", "settings": { "author": "Marcus T." } }
      ]
    }
  ]
}
{% endschema %}
