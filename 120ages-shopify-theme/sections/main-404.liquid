<div class="template-404">
  <div class="template-404__bg-glow template-404__bg-glow--one"></div>
  <div class="template-404__bg-glow template-404__bg-glow--two"></div>

  <div class="container template-404__inner">
    <div class="template-404__card">
      <p class="template-404__eyebrow">404 ERROR</p>

      <h1 class="template-404__title">
        Oops! This page<br>
        can’t be found
      </h1>

      <p class="template-404__text">
        The page you’re looking for may have been moved, deleted, or the link may be incorrect.
      </p>

      <div class="template-404__actions">
        <a href="{{ routes.root_url }}" class="template-404__btn template-404__btn--primary">
          Return Home
        </a>

        <a href="/collections/all" class="template-404__btn template-404__btn--secondary">
          Continue Shopping
        </a>
      </div>
    </div>
  </div>
</div>

<style>
  .template-404 {
    position: relative;
    overflow: hidden;
    padding: 100px 20px;
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #faf7f2;
  }

  .template-404__inner {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
  }

  .template-404__card {
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
    padding: 56px 32px;
    background: rgba(255, 255, 255, 0.82);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(0, 0, 0, 0.06);
    border-radius: 28px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.08);
  }

  .template-404__eyebrow {
    margin: 0 0 14px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #9e7556;
  }

  .template-404__title {
    margin: 0;
    font-size: clamp(2.5rem, 5vw, 4.75rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
    color: #1f1a17;
  }

  .template-404__text {
    max-width: 560px;
    margin: 24px auto 0;
    font-size: 16px;
    line-height: 1.8;
    color: rgba(31, 26, 23, 0.72);
  }

  .template-404__actions {
    margin-top: 34px;
    display: flex;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .template-404__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: 0 24px;
    border-radius: 999px;
    text-decoration: none;
    font-size: 14px;
    font-weight: 700;
    transition: all 0.25s ease;
  }

  .template-404__btn--primary {
    background: #1f1a17;
    color: #fff;
  }

  .template-404__btn--primary:hover {
    transform: translateY(-2px);
    background: #000;
  }

  .template-404__btn--secondary {
    background: transparent;
    color: #1f1a17;
    border: 1px solid rgba(31, 26, 23, 0.14);
  }

  .template-404__btn--secondary:hover {
    transform: translateY(-2px);
    background: #fff;
    border-color: rgba(31, 26, 23, 0.24);
  }

  .template-404__bg-glow {
    position: absolute;
    border-radius: 999px;
    filter: blur(60px);
    opacity: 0.45;
    pointer-events: none;
  }

  .template-404__bg-glow--one {
    width: 320px;
    height: 320px;
    background: #e6c7a8;
    top: 8%;
    left: -80px;
  }

  .template-404__bg-glow--two {
    width: 360px;
    height: 360px;
    background: #d8c2a8;
    bottom: -80px;
    right: -100px;
  }

  @media screen and (max-width: 767px) {
    .template-404 {
      padding: 72px 16px;
      min-height: 70vh;
    }

    .template-404__card {
      padding: 40px 22px;
      border-radius: 22px;
    }

    .template-404__text {
      font-size: 15px;
      margin-top: 18px;
    }

    .template-404__actions {
      margin-top: 28px;
      gap: 10px;
    }

    .template-404__btn {
      width: 100%;
    }
  }
</style>

{% schema %}
{
  "name": "404 Page",
  "settings": []
}
{% endschema %}