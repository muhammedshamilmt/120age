<section class="bg-vintage-cream px-6 py-20 md:px-12 md:py-32 lg:px-24">
  <div class="max-w-screen-2xl mx-auto">
    <div class="mb-16 flex flex-col md:flex-row md:items-end justify-between gap-6">
      <div>
        <span class="font-ultra text-[10px] tracking-[0.4em] uppercase text-forest-green block mb-4">
          {{ section.settings.subheading }}
        </span>
        <h2 class="text-4xl md:text-7xl lg:text-[100px] font-ultra uppercase leading-[0.85] tracking-tighter text-muted-brown">
          {{ section.settings.title | replace: ' ', '<br />' }}
        </h2>
      </div>
      <a href="{{ section.settings.blog.url | default: '#' }}" class="self-start md:self-end font-ultra text-[10px] tracking-[0.3em] uppercase border-b-2 border-muted-brown text-muted-brown hover:text-forest-green hover:border-forest-green transition-colors pb-1 no-underline">
        All Posts →
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {%- for article in section.settings.blog.articles limit: 3 -%}
        <article class="group cursor-pointer">
          <a href="{{ article.url }}" class="block no-underline">
            <div class="relative aspect-[4/3] overflow-hidden border-2 border-muted-brown/10 group-hover:border-muted-brown/40 transition-colors mb-5">
              {%- if article.image -%}
                {{ article.image | image_url: width: 800 | image_tag: class: 'absolute inset-0 w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-700 group-hover:scale-105' }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'absolute inset-0 w-full h-full object-cover grayscale' }}
              {%- endif -%}
              <div class="absolute top-4 left-4">
                <span class="bg-forest-green text-vintage-cream px-3 py-1 font-ultra text-[9px] tracking-widest uppercase">
                  {{ article.tags | first | default: 'Wellness' }}
                </span>
              </div>
            </div>
            <div class="flex items-center gap-4 mb-3">
              <span class="font-ultra text-[9px] tracking-widest uppercase text-muted-brown/40">{{ article.published_at | date: "%b %d, %Y" }}</span>
              <span class="w-1 h-1 rounded-full bg-muted-brown/20"></span>
              <span class="font-ultra text-[9px] tracking-widest uppercase text-muted-brown/40">{{ article.content | strip_html | split: ' ' | size | divided_by: 200 | plus: 1 }} min read</span>
            </div>
            <h3 class="font-ultra text-xl md:text-2xl uppercase text-muted-brown group-hover:text-forest-green transition-colors leading-tight mb-3">
              {{ article.title }}
            </h3>
            <p class="text-muted-brown/60 text-sm leading-relaxed line-clamp-2">
              {{ article.excerpt_or_content | strip_html | truncatewords: 30 }}
            </p>
            <div class="mt-4 h-px w-8 bg-muted-brown group-hover:w-full transition-all duration-500"></div>
          </a>
        </article>
      {%- else -%}
        {%- for i in (1..3) -%}
          <article class="group cursor-pointer opacity-50">
             <div class="relative aspect-[4/3] overflow-hidden border-2 border-muted-brown/10 mb-5">
               {{ 'image' | placeholder_svg_tag: 'absolute inset-0 w-full h-full object-cover grayscale' }}
             </div>
             <h3 class="font-ultra text-xl md:text-2xl uppercase text-muted-brown leading-tight mb-3">Journal Entry {{ i }}</h3>
             <p class="text-muted-brown/60 text-sm leading-relaxed truncate">Sample content for wellness journal...</p>
          </article>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Journal High",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Stories & Guides"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "From The Journal"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    }
  ],
  "presets": [
    {
      "name": "Journal High"
    }
  ]
}
{% endschema %}
