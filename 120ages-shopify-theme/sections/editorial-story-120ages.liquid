<section class="bg-[#1A1A1A] text-vintage-cream px-6 py-20 md:px-12 md:py-32 lg:px-24">
  <!-- Top Header Layout -->
  <div class="flex flex-col lg:flex-row justify-between items-start gap-12 mb-16 px-0 max-w-7xl mx-auto">
    <div class="max-w-4xl text-left">
      <h2 class="text-5xl md:text-7xl lg:text-9xl font-ultra uppercase leading-[0.9] tracking-tighter">
        {{ section.settings.title_line_1 }}<br />
        <span class="text-forest-green">{{ section.settings.title_line_2 }}</span>
      </h2>
    </div>
    <div class="lg:max-w-md lg:text-right self-end lg:mb-4">
      <p class="text-lg md:text-xl lg:text-2xl font-medium leading-relaxed opacity-90 italic">
        "{{ section.settings.quote }}"
      </p>
      <div class="mt-4 flex items-center lg:justify-end gap-2 text-muted-brown font-ultra tracking-widest">
        <div class="h-px w-8 bg-muted-brown hidden lg:block"></div>
        <span>{{ section.settings.est_text }}</span>
      </div>
    </div>
  </div>

  <!-- Large Featured Image -->
  <div class="relative w-full aspect-[16/9] md:aspect-[21/9] border-4 border-vintage-cream/20 overflow-hidden group max-w-7xl mx-auto">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2000 | image_tag: class: 'absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105' }}
    {%- else -%}
      <img src="https://images.unsplash.com/photo-1554118811-1e0d58224f24?auto=format&fit=crop&q=80&w=2000" alt="Vintage Cafe Interior" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
    {%- endif -%}
    <div class="absolute inset-0 bg-black/20 group-hover:bg-black/10 transition-colors"></div>
  </div>

  <!-- Stats Section -->
  <div class="mt-20 grid grid-cols-2 lg:grid-cols-4 gap-12 border-t border-vintage-cream/10 pt-16 max-w-7xl mx-auto">
    {%- for block in section.blocks -%}
      {%- if block.type == 'stat' -%}
        <div class="flex flex-col gap-2 text-left">
          <span class="text-6xl md:text-7xl font-ultra text-muted-brown">{{ block.settings.value }}</span>
          <span class="text-sm md:text-base uppercase tracking-[0.3em] font-bold opacity-70">{{ block.settings.label }}</span>
        </div>
      {%- endif -%}
    {%- endfor -%}
    
    <div class="flex flex-col gap-2 text-left">
      <span class="text-sm md:text-base uppercase tracking-[0.3em] font-bold opacity-70 mb-4">Community Choice</span>
      <span class="text-4xl md:text-5xl font-ultra uppercase leading-none">Loved<br />Locally</span>
    </div>
    <div class="flex flex-col gap-2 text-left">
      <div class="flex gap-1 mb-4">
        {%- for i in (1..5) -%}
          <svg class="w-6 h-6 fill-forest-green" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" /></svg>
        {%- endfor -%}
      </div>
      <span class="text-4xl md:text-5xl font-ultra uppercase">5 Stars</span>
      <span class="text-sm uppercase tracking-[0.3em] font-bold opacity-70">Review Average</span>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Editorial Story High",
  "settings": [
    {
      "type": "text",
      "id": "title_line_1",
      "label": "Title Line 1",
      "default": "Welcome to"
    },
    {
      "type": "text",
      "id": "title_line_2",
      "label": "Title Line 2",
      "default": "120 Ages"
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Quote",
      "default": "A peaceful spot where herbal teas and nourishing foods come together to refresh your body and soul."
    },
    {
      "type": "text",
      "id": "est_text",
      "label": "Est Text",
      "default": "EST. 2026"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Panoramic Image"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Statistic",
      "limit": 2,
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "150+"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Herbal Blends"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Editorial Story High",
      "blocks": [
        { "type": "stat", "settings": { "value": "150+", "label": "Herbal Blends" } },
        { "type": "stat", "settings": { "value": "15", "label": "Master Curators" } }
      ]
    }
  ]
}
{% endschema %}
