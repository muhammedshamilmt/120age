<section class="editorial-banner">
  <div class="container">
    <div class="editorial-banner__inner" style="background-color: var(--color-forest-green); color: #FFEAD3;">
      <div class="editorial-banner__content">
        <h2 class="h-font text-4xl mb-6">{{ section.settings.title | escape }}</h2>
        <div class="editorial-banner__text mb-8">{{ section.settings.text }}</div>
        {%- if section.settings.button_text != blank -%}
          <a href="{{ section.settings.button_link }}" class="btn btn--outline" style="border-color: #FFEAD3; color: #FFEAD3;">
            {{ section.settings.button_text | escape }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<style>
  .editorial-banner {
    padding-bottom: 8rem;
  }
  .editorial-banner__inner {
    padding: 6rem;
    text-align: center;
    border-radius: var(--border-radius);
  }
  @media (max-width: 768px) {
    .editorial-banner__inner {
      padding: 3rem 1.5rem;
    }
  }
  .text-4xl { font-size: 2.5rem; }
  .mb-6 { margin-bottom: 1.5rem; }
  .mb-8 { margin-bottom: 2rem; }
  .editorial-banner__text {
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
    font-size: 1.125rem;
    opacity: 0.9;
  }
</style>

{% schema %}
{
  "name": "Editorial Banner",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "INVEST IN YOUR FUTURE SELF"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Longevity is a practice, not a destination. Start your journey with our evidence-based wellness protocols.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "READ THE JOURNAL"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Editorial Banner"
    }
  ]
}
{% endschema %}
