<footer class="bg-black text-vintage-cream px-6 py-16 md:px-12 md:py-24 lg:px-24 border-t border-vintage-cream/10">
  <div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-16 mb-24">
      <!-- Contact Info -->
      <div class="text-left">
        <h3 class="text-4xl font-ultra uppercase tracking-tighter mb-4 text-vintage-cream">Visit us! 120 Ages</h3>
        <p class="text-xl font-ultra text-muted-brown uppercase mb-12 tracking-wide">
          {{ section.settings.tagline }}
        </p>
        
        <div class="space-y-8">
          <div>
            <h4 class="font-ultra uppercase text-xs tracking-[0.3em] text-vintage-cream/40 mb-2">Email</h4>
            <a href="mailto:{{ section.settings.email }}" class="text-2xl font-ultra uppercase hover:text-muted-brown transition-colors block no-underline text-vintage-cream">
              {{ section.settings.email }}
            </a>
          </div>
          <div>
            <h4 class="font-ultra uppercase text-xs tracking-[0.3em] text-vintage-cream/40 mb-2">Phone</h4>
            <a href="tel:{{ section.settings.phone }}" class="text-2xl font-ultra uppercase hover:text-muted-brown transition-colors block no-underline text-vintage-cream">
              {{ section.settings.phone }}
            </a>
          </div>
        </div>
      </div>

      <!-- Simple Contact Form -->
      <div class="flex flex-col justify-end">
        <div class="space-y-6 max-w-md w-full ml-auto">
          {%- form 'contact', id: 'footer-contact' -%}
            <div class="relative group mb-6">
              <input type="text" name="contact[name]" placeholder="Your Name" class="w-full bg-transparent border-b-2 border-vintage-cream/20 py-4 font-ultra uppercase text-lg focus:outline-none focus:border-muted-brown transition-colors placeholder:text-vintage-cream/20 text-vintage-cream" />
            </div>
            <button type="submit" class="w-full md:w-auto bg-forest-green text-vintage-cream px-12 py-5 font-ultra uppercase text-sm tracking-[0.2em] hover:bg-muted-brown transition-colors cursor-pointer border-none no-underline">
              Send Message
            </button>
          {%- endform -%}
        </div>
      </div>
    </div>

    <!-- Bottom Branding Section -->
    <div class="pt-16 flex flex-col items-center">
        <div class="relative w-full text-center overflow-hidden">
          <h2 class="text-[12vw] md:text-[13vw] font-ultra uppercase leading-none tracking-tighter text-vintage-cream selection:bg-forest-green opacity-100 select-none whitespace-nowrap [-webkit-text-stroke:6px_white]">
            120 Ages
          </h2>
        
        <div class="flex flex-col md:flex-row justify-between items-center w-full mt-12 gap-4 border-t border-vintage-cream/10 pt-8 px-0">
            <p class="font-ultra text-[10px] uppercase tracking-[0.4em] text-vintage-cream/40">
              © {{ 'now' | date: "%Y" }} 120 AGES • ALL RIGHTS RESERVED • <a href="/pages/privacy" class="hover:text-forest-green transition-colors no-underline text-vintage-cream/40">PRIVACY</a>
            </p>

          <div class="flex gap-8">
            <span class="font-ultra text-[10px] uppercase tracking-[0.4em] text-vintage-cream/40 cursor-default hover:text-forest-green transition-colors">LON</span>
            <span class="font-ultra text-[10px] uppercase tracking-[0.4em] text-vintage-cream/40 cursor-default hover:text-forest-green transition-colors">NYC</span>
            <span class="font-ultra text-[10px] uppercase tracking-[0.4em] text-vintage-cream/40 cursor-default hover:text-forest-green transition-colors">PAR</span>
          </div>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer High",
  "settings": [
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Sip Healthy. Live Longer."
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email",
      "default": "hello@120ages.com"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone",
      "default": "+91-9020480880"
    }
  ],
  "presets": [
    {
      "name": "Footer High"
    }
  ]
}
{% endschema %}
