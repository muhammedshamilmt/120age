<section class="bg-[#1A1A1A] px-6 py-20 md:px-12 md:py-32 lg:px-24 overflow-hidden">
  <div class="max-w-screen-2xl mx-auto">
    <div class="mb-16 flex flex-col md:flex-row md:items-end justify-between gap-6">
      <div>
        <span class="font-ultra text-[10px] tracking-[0.4em] uppercase text-forest-green block mb-4">
          {{ section.settings.subheading }}
        </span>
        <h2 class="text-4xl md:text-7xl lg:text-[100px] font-ultra uppercase leading-[0.85] tracking-tighter text-vintage-cream">
          {{ section.settings.title | replace: ' ', '<br />' }}
        </h2>
      </div>
      <a href="{{ section.settings.collection.url | default: '/collections/all' }}" class="self-start md:self-end font-ultra text-[10px] tracking-[0.3em] uppercase border-b-2 border-vintage-cream/40 text-vintage-cream/60 hover:text-forest-green hover:border-forest-green transition-colors pb-1">
        Shop All →
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {%- assign collection = section.settings.collection -%}
      {%- for product in collection.products limit: section.settings.products_to_show -%}
        <a href="{{ product.url }}" class="group block">
          <div class="relative aspect-square overflow-hidden border border-vintage-cream/10 group-hover:border-forest-green/40 transition-colors mb-5">
            {%- if product.featured_media != blank -%}
              {{ product.featured_media | image_url: width: 800 | image_tag: class: 'absolute inset-0 w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-700 group-hover:scale-105' }}
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'absolute inset-0 w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-700 group-hover:scale-105' }}
            {%- endif -%}
            
            <div class="absolute top-4 left-4 flex flex-col gap-2">
              <span class="bg-forest-green text-vintage-cream px-3 py-1 font-ultra text-[9px] tracking-widest uppercase">
                New
              </span>
            </div>
            <div class="absolute bottom-0 right-0 bg-vintage-cream/10 backdrop-blur-sm px-3 py-2">
              <span class="font-ultra text-vintage-cream text-sm">{{ product.price | money }}</span>
            </div>
          </div>
          <div class="flex items-start justify-between gap-4 text-left">
            <div>
              <span class="font-ultra text-[9px] tracking-[0.3em] uppercase text-forest-green block mb-1">
                {{ product.type | default: 'Herbal Tea' }}
              </span>
              <h3 class="font-ultra text-lg uppercase text-vintage-cream group-hover:text-forest-green transition-colors leading-tight">
                {{ product.title }}
              </h3>
            </div>
            <span class="font-ultra text-[9px] tracking-widest uppercase text-vintage-cream/30 mt-1">
              0{{ forloop.index }}
            </span>
          </div>
        </a>
      {%- else -%}
        {%- for i in (1..3) -%}
          <div class="group block">
             <div class="relative aspect-square overflow-hidden border border-vintage-cream/10 mb-5">
               {{ 'product-' | append: i | placeholder_svg_tag: 'absolute inset-0 w-full h-full object-cover grayscale' }}
             </div>
             <div class="flex items-start justify-between gap-4 text-left">
                <div>
                  <span class="font-ultra text-[9px] tracking-[0.3em] uppercase text-forest-green block mb-1">Herbal Tea</span>
                  <h3 class="font-ultra text-lg uppercase text-vintage-cream leading-tight">Sample Product {{ i }}</h3>
                </div>
                <span class="font-ultra text-[9px] tracking-widest uppercase text-vintage-cream/30 mt-1">0{{ i }}</span>
             </div>
          </div>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Products High",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Just Dropped"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "New Arrivals"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 3,
      "max": 9,
      "step": 3,
      "default": 3,
      "label": "Products to show"
    }
  ],
  "presets": [
    {
      "name": "Featured Products High"
    }
  ]
}
{% endschema %}
