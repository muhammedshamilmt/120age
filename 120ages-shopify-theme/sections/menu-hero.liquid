<section class="menu-hero section-spacing text-center bg-cream">
  <div class="max-w-4xl mx-auto px-6">
    <h1 class="h-font text-6xl md:text-8xl text-muted-brown mb-6 tracking-tight uppercase">
      {{ section.settings.title | escape }}
    </h1>
    <p class="h-font text-lg md:text-xl text-forest-green uppercase tracking-widest">
      {{ section.settings.subheading | escape }}
    </p>
    <div class="mt-8 flex justify-center">
      <div class="h-1 w-24 bg-forest-green/30"></div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Menu Hero",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "MENU"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Nourishing Your Soul, One Sip at a Time"
    }
  ],
  "presets": [
    {
      "name": "Menu Hero"
    }
  ]
}
{% endschema %}
