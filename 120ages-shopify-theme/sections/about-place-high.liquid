<section class="py-24 bg-[#1A1A1A] border-t border-vintage-cream/10">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <!-- Left: Info -->
      <div class="text-left">
        <span class="font-ultra text-forest-green text-sm tracking-[0.3em] uppercase mb-4 block">
          {{ section.settings.subheading }}
        </span>
        <h2 class="text-5xl md:text-8xl font-ultra text-vintage-cream uppercase leading-[0.85] tracking-tighter mb-8">
          {{ section.settings.title_line_1 }} <br />
          <span class="text-forest-green">{{ section.settings.title_line_2 }}</span>
        </h2>
        
        <p class="text-xl text-vintage-cream/80 font-medium leading-relaxed mb-12 max-w-md">
          {{ section.settings.text }}
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
          <div>
            <h4 class="font-ultra text-forest-green text-sm tracking-widest uppercase mb-4 opacity-50">
              Address
            </h4>
            <p class="text-2xl font-ultra text-vintage-cream uppercase">
              {{ section.settings.address }}
            </p>
          </div>
          <div>
            <h4 class="font-ultra text-forest-green text-sm tracking-widest uppercase mb-4 opacity-50">
              Hours
            </h4>
            <p class="text-2xl font-ultra text-vintage-cream uppercase">
              {{ section.settings.hours }}
            </p>
          </div>
        </div>
      </div>

      <!-- Right: Map -->
      <div class="relative aspect-square md:aspect-video lg:aspect-square bg-black border-2 border-vintage-cream/20 p-4 group">
        <div class="w-full h-full relative overflow-hidden grayscale contrast-125 opacity-70 group-hover:grayscale-0 group-hover:opacity-100 transition-all duration-700">
          <iframe
            src="{{ section.settings.map_url }}"
            width="100%"
            height="100%"
            style="border: 0;"
            allowfullscreen=""
            loading="lazy"
            title="Our Location">
          </iframe>
        </div>
        <!-- Decorative Overlay -->
        <div class="absolute inset-0 pointer-events-none border-[20px] border-[#1A1A1A]/80 m-4"></div>
        <div class="absolute top-8 left-8 bg-forest-green text-vintage-cream p-3 font-ultra text-xs tracking-tighter uppercase rotate-[-4deg]">
          Find Your Way
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About Place High",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Visit Us"
    },
    {
      "type": "text",
      "id": "title_line_1",
      "label": "Title Line 1",
      "default": "Our"
    },
    {
      "type": "text",
      "id": "title_line_2",
      "label": "Title Line 2",
      "default": "Place"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Nestled in a quiet corner, our café invites you to unwind and nourish your body and mind."
    },
    {
      "type": "text",
      "id": "address",
      "label": "Address",
      "default": "123 Herbal Lane"
    },
    {
      "type": "text",
      "id": "hours",
      "label": "Hours",
      "default": "8am - 8pm"
    },
    {
      "type": "text",
      "id": "map_url",
      "label": "Map Embed URL",
      "default": "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3022.2151528095767!2d-73.98784308459404!3d40.75797477932688!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x89c25855c6480293%3A0x16b610c1f6c4493a!2sTimes%20Square!5e0!3m2!1sen!2sus!4v1625576543210!5m2!1sen!2sus"
    }
  ],
  "presets": [
    {
      "name": "About Place High"
    }
  ]
}
{% endschema %}
