<section class="py-16 px-6 md:px-12 lg:px-24 bg-vintage-cream border-t border-muted-brown/10">
  <div class="max-w-7xl mx-auto">
    <!-- Tab Nav -->
    <div class="flex flex-wrap gap-0 border-b-2 border-muted-brown/10 mb-12 overflow-x-auto no-scrollbar">
      <button class="tab-btn active font-ultra text-[10px] tracking-[0.3em] uppercase px-6 py-4 border-b-2 border-muted-brown text-muted-brown transition-all whitespace-nowrap cursor-pointer hover:text-muted-brown bg-transparent" data-tab="description">Description</button>
      <button class="tab-btn font-ultra text-[10px] tracking-[0.3em] uppercase px-6 py-4 border-b-2 border-transparent text-muted-brown/40 hover:text-muted-brown transition-all whitespace-nowrap cursor-pointer bg-transparent" data-tab="benefits">Benefits</button>
      <button class="tab-btn font-ultra text-[10px] tracking-[0.3em] uppercase px-6 py-4 border-b-2 border-transparent text-muted-brown/40 hover:text-muted-brown transition-all whitespace-nowrap cursor-pointer bg-transparent" data-tab="storage">Storage</button>
      <button class="tab-btn font-ultra text-[10px] tracking-[0.3em] uppercase px-6 py-4 border-b-2 border-transparent text-muted-brown/40 hover:text-muted-brown transition-all whitespace-nowrap cursor-pointer bg-transparent" data-tab="howtouse">How to Use</button>
      <button class="tab-btn font-ultra text-[10px] tracking-[0.3em] uppercase px-6 py-4 border-b-2 border-transparent text-muted-brown/40 hover:text-muted-brown transition-all whitespace-nowrap cursor-pointer bg-transparent" data-tab="faqs">FAQs</button>
    </div>

    <!-- Description -->
    <div class="tab-panel active block text-left" id="tab-description">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div class="space-y-6">
          <h3 class="font-ultra text-3xl md:text-4xl uppercase leading-tight text-muted-brown">What is <br /><span class="text-forest-green">{{ product.title }}?</span></h3>
          <div class="text-muted-brown/70 text-lg leading-relaxed font-medium">
            {{ product.description }}
          </div>
          <div class="grid grid-cols-3 gap-6 pt-4 border-t border-muted-brown/10">
            <div>
              <p class="font-ultra text-3xl text-muted-brown">100%</p>
              <p class="font-ultra text-[9px] tracking-widest uppercase text-muted-brown/50 mt-1">Natural & Pure</p>
            </div>
            <div>
              <p class="font-ultra text-3xl text-muted-brown">Heritage</p>
              <p class="font-ultra text-[9px] tracking-widest uppercase text-muted-brown/50 mt-1">Authentic Sourcing</p>
            </div>
            <div>
              <p class="font-ultra text-3xl text-muted-brown">Eco</p>
              <p class="font-ultra text-[9px] tracking-widest uppercase text-muted-brown/50 mt-1">Crated for Earth</p>
            </div>
          </div>
        </div>
        <div class="relative aspect-[4/3] border-2 border-muted-brown/10 overflow-hidden">
          {%- if product.media[1] -%}
            {{ product.media[1] | image_url: width: 1200 | image_tag: class: 'absolute inset-0 w-full h-full object-cover' }}
          {%- else -%}
            <img src="https://images.unsplash.com/photo-1596040033229-a9821ebd058d?q=80&w=1200" alt="Turmeric Description" class="absolute inset-0 w-full h-full object-cover" />
          {%- endif -%}
        </div>
      </div>
    </div>

    <!-- Benefits -->
    <div class="tab-panel hidden text-left" id="tab-benefits">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {%- if product.metafields.custom.benefits != blank -%}
           <div class="col-span-full text-muted-brown/70 text-lg leading-relaxed font-medium border-2 border-muted-brown/10 p-10">
             {{ product.metafields.custom.benefits | richtext }}
           </div>
        {%- else -%}
          {%- for i in (1..3) -%}
            <div class="border-2 border-muted-brown/10 p-8 space-y-4 hover:border-muted-brown transition-colors group">
              <div class="w-10 h-10 border-2 border-forest-green flex items-center justify-center">
                <svg class="w-5 h-5 text-forest-green" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              </div>
              <h4 class="font-ultra text-xl uppercase text-muted-brown group-hover:text-forest-green transition-colors">Benefit 0{{ i }}</h4>
              <p class="text-muted-brown/60 text-sm leading-relaxed">High-potency active compounds designed to support your natural vitality and long-term health.</p>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>

    <!-- Storage -->
    <div class="tab-panel hidden text-left" id="tab-storage">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div class="space-y-8">
          <h3 class="font-ultra text-3xl md:text-4xl uppercase leading-tight text-muted-brown">Storing Your<br />Blends Right</h3>
          <div class="space-y-6">
            <div class="flex gap-5 items-start">
              <div class="w-8 h-8 border-2 border-muted-brown flex items-center justify-center flex-shrink-0 font-ultra text-muted-brown text-sm">1</div>
              <div>
                <p class="font-ultra text-sm uppercase tracking-widest text-muted-brown mb-1">Airtight Container</p>
                <p class="text-muted-brown/60 text-sm leading-relaxed">Store in an airtight glass or ceramic container to prevent moisture and oxidation.</p>
              </div>
            </div>
            <div class="flex gap-5 items-start">
              <div class="w-8 h-8 border-2 border-muted-brown flex items-center justify-center flex-shrink-0 font-ultra text-muted-brown text-sm">2</div>
              <div>
                <p class="font-ultra text-sm uppercase tracking-widest text-muted-brown mb-1">Cool & Dry Place</p>
                <p class="text-muted-brown/60 text-sm leading-relaxed">Keep away from heat sources. A pantry or kitchen cabinet away from the stove is ideal.</p>
              </div>
            </div>
            <div class="flex gap-5 items-start">
              <div class="w-8 h-8 border-2 border-muted-brown flex items-center justify-center flex-shrink-0 font-ultra text-muted-brown text-sm">3</div>
              <div>
                <p class="font-ultra text-sm uppercase tracking-widest text-muted-brown mb-1">Away from Sunlight</p>
                <p class="text-muted-brown/60 text-sm leading-relaxed">Keep in a dark spot to maintain potency and vibrant color of herbal blends.</p>
              </div>
            </div>
          </div>
        </div>
        <div class="relative aspect-square border-2 border-muted-brown/10 overflow-hidden">
          {%- if product.media[2] -%}
            {{ product.media[2] | image_url: width: 1000 | image_tag: class: 'absolute inset-0 w-full h-full object-cover' }}
          {%- else -%}
            <img src="https://images.unsplash.com/photo-1599940824399-b87987ceb72a?q=80&w=1200" alt="Storage" class="absolute inset-0 w-full h-full object-cover" />
          {%- endif -%}
        </div>
      </div>
    </div>

    <!-- How to Use -->
    <div class="tab-panel hidden text-left" id="tab-howtouse">
      <div class="space-y-10">
        <h3 class="font-ultra text-3xl md:text-4xl uppercase leading-tight text-muted-brown">Ways to Use<br /><span class="text-forest-green">This Ritual</span></h3>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <div class="bg-vintage-cream border-2 border-muted-brown/15 p-8 space-y-4">
            <span class="font-ultra text-[10px] tracking-[0.4em] text-forest-green uppercase">01</span>
            <h4 class="font-ultra text-2xl uppercase leading-none text-muted-brown">Morning Sip</h4>
            <p class="text-muted-brown/60 text-sm leading-relaxed">Add to your favorite warm drink to activate your metabolism and boost daily immunity.</p>
          </div>
          <div class="bg-vintage-cream border-2 border-muted-brown/15 p-8 space-y-4">
            <span class="font-ultra text-[10px] tracking-[0.4em] text-forest-green uppercase">02</span>
            <h4 class="font-ultra text-2xl uppercase leading-none text-muted-brown">Culinary</h4>
            <p class="text-muted-brown/60 text-sm leading-relaxed">Incorporate into your daily meals. For spices, a little goes a long way to add depth and health.</p>
          </div>
          <div class="bg-vintage-cream border-2 border-muted-brown/15 p-8 space-y-4">
            <span class="font-ultra text-[10px] tracking-[0.4em] text-forest-green uppercase">03</span>
            <h4 class="font-ultra text-2xl uppercase leading-none text-muted-brown">Night Ritual</h4>
            <p class="text-muted-brown/60 text-sm leading-relaxed">Brew a calming tea before rest to support deep relaxation and cellular recovery.</p>
          </div>
        </div>
      </div>
    </div>

    <!-- FAQs -->
    <div class="tab-panel hidden text-left" id="tab-faqs">
      <div class="max-w-3xl space-y-0">
        <h3 class="font-ultra text-3xl md:text-4xl uppercase leading-tight text-muted-brown mb-10">Frequently Asked<br /><span class="text-forest-green">Questions</span></h3>
        {%- for i in (1..3) -%}
          <div class="faq-item border-t-2 border-muted-brown/10">
            <button class="faq-btn w-full flex justify-between items-center py-6 text-left cursor-pointer group bg-transparent border-none">
              <span class="font-ultra text-sm uppercase tracking-widest text-muted-brown group-hover:text-forest-green transition-colors pr-8">Is this product 100% natural?</span>
              <span class="font-ultra text-2xl text-muted-brown/40 flex-shrink-0 faq-icon transition-transform">+</span>
            </button>
            <div class="faq-answer hidden pb-6">
              <p class="text-muted-brown/60 text-sm leading-relaxed">Yes, all 120 Ages products are sourced from heritage gardens and prepared using traditional methods to ensure 100% purity with no artificial additives.</p>
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Tabs Logic
    const tabBtns = document.querySelectorAll('.tab-btn');
    const tabPanels = document.querySelectorAll('.tab-panel');

    tabBtns.forEach(btn => {
      btn.addEventListener('click', function() {
        tabBtns.forEach(b => {
          b.classList.remove('active', 'border-muted-brown', 'text-muted-brown');
          b.classList.add('border-transparent', 'text-muted-brown/40');
        });
        tabPanels.forEach(p => p.classList.add('hidden'));
        tabPanels.forEach(p => p.classList.remove('block'));

        this.classList.add('active', 'border-muted-brown', 'text-muted-brown');
        this.classList.remove('border-transparent', 'text-muted-brown/40');
        const activePanel = document.getElementById('tab-' + this.dataset.tab);
        activePanel.classList.remove('hidden');
        activePanel.classList.add('block');
      });
    });

    // FAQ Accordion
    document.querySelectorAll('.faq-btn').forEach(btn => {
      btn.addEventListener('click', function() {
        const answer = this.nextElementSibling;
        const icon = this.querySelector('.faq-icon');
        const isOpen = !answer.classList.contains('hidden');
        
        document.querySelectorAll('.faq-answer').forEach(a => a.classList.add('hidden'));
        document.querySelectorAll('.faq-icon').forEach(i => {
           i.textContent = '+';
           i.classList.remove('rotate-45');
        });

        if (!isOpen) {
          answer.classList.remove('hidden');
          icon.textContent = '−';
          icon.classList.add('rotate-45');
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "Product Tabs High",
  "settings": [],
  "presets": [
    {
      "name": "Product Tabs High"
    }
  ]
}
{% endschema %}
