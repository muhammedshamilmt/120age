<section class="bg-vintage-cream px-6 py-20 md:px-12 md:py-32 lg:px-24">
  <div class="max-w-screen-2xl mx-auto">
    <div class="mb-16 flex flex-col md:flex-row md:items-end justify-between gap-6">
      <div>
        <span class="font-ultra text-[10px] tracking-[0.4em] uppercase text-forest-green block mb-4">
          {{ section.settings.subheading }}
        </span>
        <h2 class="text-4xl md:text-7xl lg:text-[100px] font-ultra uppercase leading-[0.85] tracking-tighter text-muted-brown text-left">
          {{ section.settings.title | replace: ' ', '<br />' }}
        </h2>
      </div>
      <a href="{{ section.settings.collection.url | default: '/collections/all' }}" class="self-start md:self-end font-ultra text-[10px] tracking-[0.3em] uppercase border-b-2 border-muted-brown text-muted-brown hover:text-forest-green hover:border-forest-green transition-colors pb-1">
        Shop All →
      </a>
    </div>

    <div class="space-y-0 divide-y-2 divide-muted-brown/10">
      {%- assign collection = section.settings.collection -%}
      {%- for product in collection.products limit: section.settings.products_to_show -%}
        <a href="{{ product.url }}" class="group flex items-center gap-6 md:gap-10 py-6 hover:bg-muted-brown/5 px-2 transition-colors">
          <span class="font-ultra text-[10px] tracking-widest text-muted-brown/30 w-6 shrink-0">
            0{{ forloop.index }}
          </span>
          <div class="relative w-16 h-16 md:w-20 md:h-20 shrink-0 overflow-hidden border border-muted-brown/10 rounded-full">
            {%- if product.featured_media != blank -%}
              {{ product.featured_media | image_url: width: 200 | image_tag: class: 'absolute inset-0 w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500' }}
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'absolute inset-0 w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500' }}
            {%- endif -%}
          </div>
          <div class="flex-1 min-w-0 text-left">
            <span class="font-ultra text-[9px] tracking-[0.3em] uppercase text-forest-green block mb-1">
              {{ product.type | default: 'Wellness' }}
            </span>
            <h3 class="font-ultra text-lg md:text-2xl uppercase text-muted-brown group-hover:text-forest-green transition-colors truncate">
              {{ product.title }}
            </h3>
          </div>
          {%- if product.compare_at_price > product.price -%}
            <span class="hidden md:block bg-muted-brown text-vintage-cream px-3 py-1 font-ultra text-[9px] tracking-widest uppercase rounded-full shrink-0">
              SALE
            </span>
          {%- endif -%}
          <span class="font-ultra text-lg md:text-2xl text-muted-brown shrink-0">
            {{ product.price | money }}
          </span>
          <span class="font-ultra text-[10px] tracking-widest text-muted-brown/30 group-hover:text-muted-brown transition-colors shrink-0">
            →
          </span>
        </a>
      {%- else -%}
        {%- for i in (1..3) -%}
          <div class="group flex items-center gap-6 md:gap-10 py-6 hover:bg-muted-brown/5 px-2 transition-colors">
            <span class="font-ultra text-[10px] tracking-widest text-muted-brown/30 w-6 shrink-0">0{{ i }}</span>
            <div class="relative w-16 h-16 md:w-20 md:h-20 shrink-0 overflow-hidden border border-muted-brown/10 rounded-full">
              {{ 'product-' | append: i | placeholder_svg_tag: 'absolute inset-0 w-full h-full object-cover grayscale transition-all duration-500' }}
            </div>
            <div class="flex-1 min-w-0 text-left">
              <span class="font-ultra text-[9px] tracking-[0.3em] uppercase text-forest-green block mb-1">Wellness</span>
              <h3 class="font-ultra text-lg md:text-2xl uppercase text-muted-brown truncate">Sample Best Seller {{ i }}</h3>
            </div>
            <span class="font-ultra text-lg md:text-2xl text-muted-brown shrink-0">$42.00</span>
            <span class="font-ultra text-[10px] tracking-widest text-muted-brown/30 shrink-0">→</span>
          </div>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Best Sellers High",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Fan Favourites"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Best Sellers"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4,
      "label": "Products to show"
    }
  ],
  "presets": [
    {
      "name": "Best Sellers High"
    }
  ]
}
{% endschema %}
