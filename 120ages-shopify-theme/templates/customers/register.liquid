<div class="customer-register section-spacing container--narrow text-center">
  <h1 class="h-font text-5xl mb-12">CREATE ACCOUNT</h1>
  {% form 'create_customer' %}
    {{ form.errors | default_errors }}
    <div class="mb-6">
      <input type="text" name="customer[first_name]" placeholder="FIRST NAME" class="footer__input" style="max-width: 400px; margin: 0 auto; display: block;">
    </div>
    <div class="mb-6">
      <input type="text" name="customer[last_name]" placeholder="LAST NAME" class="footer__input" style="max-width: 400px; margin: 0 auto; display: block;">
    </div>
    <div class="mb-6">
      <input type="email" name="customer[email]" placeholder="EMAIL" class="footer__input" style="max-width: 400px; margin: 0 auto; display: block;">
    </div>
    <div class="mb-8">
      <input type="password" name="customer[password]" placeholder="PASSWORD" class="footer__input" style="max-width: 400px; margin: 0 auto; display: block;">
    </div>
    <button type="submit" class="btn">CREATE</button>
  {% endform %}
</div>
